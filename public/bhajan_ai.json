{
 "title": "हनुमान चालीसा",
 "lines": [
  {
   "start": 10.02,
   "end": 16.58,
   "text": "श्रीगुरु चरन सरोज रज, निज मनु मुकुरु सुधारि।"
  },
  {
   "start": 16.6,
   "end": 19.72,
   "text": "बरनउँ रघुबर बिमल जसु, जो दायकु फल चारि॥"
  },
  {
   "start": 19.72,
   "end": 27.2,
   "text": "बुद्धिहीन तनु जानिके, सुमिरौं पवन-कुमार।"
  },
  {
   "start": 28.74,
   "end": 39.88,
   "text": "बल बुद्धि बिद्या देहु मोहिं, हरहु कलेस बिकार॥"
  },
  {
   "start": 40.16,
   "end": 42.7,
   "text": "जय हनुमान ज्ञान गुन सागर।"
  },
  {
   "start": 42.8,
   "end": 44.74,
   "text": "जय कपीस तिहुँ लोक उजागर॥"
  },
  {
   "start": 45.16,
   "end": 47.44,
   "text": "राम दूत अतुलित बल धामा।"
  },
  {
   "start": 48.22,
   "end": 51.22,
   "text": "अंजनि-पुत्र पवनसुत नामा॥"
  },
  {
   "start": 52.38,
   "end": 54.3,
   "text": "महाबीर बिक्रम बजरंगी।"
  },
  {
   "start": 55.68,
   "end": 58.18,
   "text": "कुमति निवार सुमति के संगी॥"
  }
 ]
}